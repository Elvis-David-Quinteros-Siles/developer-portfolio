# ==============================================================================
# Portfolio — Variables de entorno
# Copia este archivo a `.env` y ajusta los valores. NUNCA commitees `.env`.
# ==============================================================================

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-strong-password
# URL interna (DNS de Docker). Los servicios la consumen tal cual.
# El host `postgres` es el contenedor del compose (desarrollo). Con Postgres
# externo (producción) cámbialo por el nombre de TU contenedor — ver PG_CONTAINER
# más abajo y docs/DEPLOYMENT.md § "PostgreSQL externo".
DATABASE_URL=postgres://portfolio:change-me-strong-password@postgres:5432/portfolio?sslmode=disable

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# --- Seguridad ----------------------------------------------------------------
# Firma de JWT (HS256). Genera uno: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret-64-hex
# Token para llamadas servicio-a-servicio (Go -> Django). openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=change-me-internal-token
# Credenciales del único usuario admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# --- Django -------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-django-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=graphql-api,localhost
# Vacío => verificación ReCaptcha deshabilitada (preparada, no exigida)
RECAPTCHA_SECRET_KEY=

# --- Notificación de contacto -------------------------------------------------
# `log`  => el mensaje queda en el log del worker (`docker compose logs celery-worker`).
# `smtp` => se envía por correo; entonces NOTIFY_EMAIL_TO y EMAIL_* son obligatorios.
NOTIFIER_BACKEND=log
# Dirección que RECIBE los avisos (la tuya).
NOTIFY_EMAIL_TO=
# Servidor SMTP. Gmail: smtp.gmail.com:587 con TLS y una contraseña de
# aplicación (las de 16 caracteres), NUNCA la contraseña de la cuenta:
# requiere verificación en dos pasos → https://myaccount.google.com/apppasswords
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Excluyentes: TLS para el puerto 587, SSL para el 465.
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
# Remitente. Vacío => se usa EMAIL_HOST_USER. Muchos proveedores rechazan un
# remitente distinto de la cuenta autenticada.
DEFAULT_FROM_EMAIL=

# --- Edge ---------------------------------------------------------------------
# Puerto publicado por Nginx en el host (80 en producción; cámbialo si está ocupado)
NGINX_PORT=80

# --- Gateway ------------------------------------------------------------------
CORS_ORIGINS=http://localhost
RATE_LIMIT_GLOBAL=100        # req/min por IP
RATE_LIMIT_CONTACT=5         # req/hora por IP en contacto

# --- Go API -------------------------------------------------------------------
GIN_MODE=release
LOG_LEVEL=info

# --- Frontend (build-time) ----------------------------------------------------
# La SPA llama rutas relativas (/api, /graphql) a través de Nginx: no necesita URL absoluta.
VITE_APP_NAME=Portfolio

# ==============================================================================
# Producción con `-f docker-compose.yml -f docker-compose.prod.yml`
# (en desarrollo estas variables se ignoran). Ver docs/DEPLOYMENT.md.
# ==============================================================================

# --- Imágenes -----------------------------------------------------------------
# Deben coincidir con lo que publica el pipeline. IMAGE_TAG lo sobrescribe el
# deploy con el SHA del commit: `latest` es solo el valor de arranque.
REGISTRY=ghcr.io/elvis-david-quinteros-siles
IMAGE_PREFIX=portfolio
IMAGE_TAG=latest

# --- PostgreSQL externo -------------------------------------------------------
# Nombre del contenedor de PostgreSQL que ya corre en el servidor. Es además el
# host DNS que resuelven los servicios dentro de la red compartida, así que debe
# ser el mismo que aparece en DATABASE_URL.
PG_CONTAINER=postgres
# Red Docker compartida con ese contenedor. `scripts/db-bootstrap.sh` la crea y
# engancha el contenedor si todavía no está.
EXTERNAL_DB_NETWORK=portfolio-dbnet
